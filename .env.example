# ============================================================
# AI DevOps Agent – Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_NAME="AI DevOps Agent"
APP_ENV=development
APP_VERSION=0.1.0

# ── Server ──────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ── API ─────────────────────────────────────────────────────
API_V1_PREFIX=/api/v1

# ── CORS (comma-separated list) ─────────────────────────────
# Adjust for your environment (staging, production, etc.)
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Frontend API base (Vite env var) ────────────────────────
VITE_API_BASE_URL=http://localhost:8000

# ============================================================
# Phase 2 – GitHub Integration
# ============================================================
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=

# ============================================================
# Phase 3 – AI / LLM Provider (leave blank until Phase 3)
# ============================================================
OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=

# ============================================================
# Phase 4 – Kubernetes & Docker (leave blank until Phase 4)
# ============================================================
KUBECONFIG=
DOCKER_HOST=
